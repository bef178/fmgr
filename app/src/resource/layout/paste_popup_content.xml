<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <include layout="@layout/status_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="12dp"
                android:paddingTop="4dp"
                android:text="@string/target_directory"
                android:textColor="@color/grey_700"
                android:textSize="11sp" />

            <pd.droidapp.fmgr.view.ButtonScrollView
                android:id="@+id/target_directory_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="12dp"
                android:buttonTint="@color/purple_200"
                android:scrollbars="horizontal">

                <TextView
                    android:id="@+id/target_directory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textSize="14sp" />

            </pd.droidapp.fmgr.view.ButtonScrollView>

        </LinearLayout>

        <ImageButton
            android:id="@+id/change_directory"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/pick_directory"
            android:src="@drawable/ic_directory_24" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@color/white"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="12dp"
            android:paddingTop="4dp"
            android:text="@string/on_conflict"
            android:textColor="@color/grey_700"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/resolution_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="12dp"
            android:textSize="14sp"
            android:visibility="gone" />

        <RadioGroup
            android:id="@+id/resolution_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/resolution_option_overwrite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:button="@null"
                android:drawableStart="@drawable/ic_ctrl_radio_24"
                android:minHeight="32dp"
                android:paddingStart="24dp"
                android:paddingEnd="12dp"
                android:text="@string/resolution_option_overwrite"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/resolution_option_rename_incoming"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:button="@null"
                android:checked="true"
                android:drawableStart="@drawable/ic_ctrl_radio_24"
                android:minHeight="32dp"
                android:paddingStart="24dp"
                android:paddingEnd="12dp"
                android:text="@string/resolution_option_rename_incoming" />

            <RadioButton
                android:id="@+id/resolution_option_skip_incoming"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:button="@null"
                android:drawableStart="@drawable/ic_ctrl_radio_24"
                android:minHeight="32dp"
                android:paddingStart="24dp"
                android:paddingEnd="12dp"
                android:text="@string/resolution_option_skip_incoming" />

        </RadioGroup>

        <CheckBox
            android:id="@+id/merge_directories_checkbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:button="@null"
            android:checked="true"
            android:drawableStart="@drawable/ic_ctrl_check_24"
            android:minHeight="32dp"
            android:paddingStart="24dp"
            android:paddingEnd="12dp"
            android:text="@string/merge_directories_check"
            android:textSize="14sp" />

    </LinearLayout>

    <pd.droidapp.fmgr.view.FastScrollRecyclerView
        android:id="@+id/popup_items_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:divider="@drawable/item_divider"
        android:scrollbarStyle="insideOverlay"
        android:scrollbars="vertical" />

</merge>
