<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- rounded square outline, outer size matching ic_radio_24's ring -->
    <path
        android:strokeWidth="1.5"
        android:fillColor="@android:color/transparent"
        android:pathData="M 8.625,5.25 h 6.75 a 3.375,3.375 0 0,1 3.375,3.375 v 6.75 a 3.375,3.375 0 0,1 -3.375,3.375 h -6.75 a 3.375,3.375 0 0,1 -3.375,-3.375 v -6.75 a 3.375,3.375 0 0,1 3.375,-3.375 z">
        <aapt:attr name="android:strokeColor">
            <selector>
                <item android:state_enabled="false" android:alpha="0.38" android:color="?attr/colorOnSurface" />
                <item android:state_checked="true" android:state_enabled="true" android:color="?attr/colorPrimary" />
                <item android:color="?attr/colorOnSurfaceVariant" />
            </selector>
        </aapt:attr>
    </path>

    <!-- check (copied from i_check_16, scaled into the inset box), visible only when checked -->
    <path
        android:pathData="M 7.8,12 l 2.8125,2.8125 5.625,-5.625"
        android:strokeWidth="2.5"
        android:strokeLineCap="square">
        <aapt:attr name="android:strokeColor">
            <selector>
                <item android:state_checked="true" android:state_enabled="false" android:alpha="0.38" android:color="?attr/colorOnSurface" />
                <item android:state_checked="true" android:state_enabled="true" android:color="?attr/colorPrimary" />
                <item android:state_checked="true" android:color="?attr/colorOnSurfaceVariant" />
                <item android:color="@android:color/transparent" />
            </selector>
        </aapt:attr>
    </path>

</vector>
