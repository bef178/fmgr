<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000">

    <LinearLayout
        android:id="@+id/popup_area"
        android:layout_width="match_parent"
        android:layout_height="560dp"
        android:layout_gravity="center"
        android:layout_margin="40dp"
        android:background="@color/white"
        android:orientation="vertical">

        <include layout="@layout/popup_title_bar" />

        <include layout="@layout/status_bar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/grey_100"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/resolution_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="4dp"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/resolution_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/resolution_option_overwrite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:button="@null"
                    android:drawableStart="@drawable/radio_button"
                    android:minHeight="32dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="12dp"
                    android:text="@string/resolution_option_overwrite"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/resolution_option_rename_incoming"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:button="@null"
                    android:checked="true"
                    android:drawableStart="@drawable/radio_button"
                    android:minHeight="32dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="12dp"
                    android:text="@string/resolution_option_rename_incoming" />

                <RadioButton
                    android:id="@+id/resolution_option_skip_incoming"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:button="@null"
                    android:drawableStart="@drawable/radio_button"
                    android:minHeight="32dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="12dp"
                    android:text="@string/resolution_option_skip_incoming" />

            </RadioGroup>

            <CheckBox
                android:id="@+id/merge_directories_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:button="@null"
                android:checked="true"
                android:drawableStart="@drawable/ic_check_24"
                android:minHeight="32dp"
                android:paddingStart="24dp"
                android:paddingEnd="12dp"
                android:text="@string/merge_directories_check"
                android:textSize="14sp" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/popup_items_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:scrollbarStyle="insideOverlay"
            android:scrollbars="vertical" />

        <include layout="@layout/popup_button_bar" />

    </LinearLayout>

</FrameLayout>
